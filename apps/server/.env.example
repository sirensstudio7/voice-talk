# apps/server local development environment.
# Copy to apps/server/.env — cmd/api/main.go and cmd/migrate/main.go load
# it via godotenv if present (no-op if absent, e.g. real deploys set env
# vars directly rather than shipping a .env file).

APP_ENV=development
PORT=8000

# --- Database (local Docker Postgres via `docker-compose up` at repo root) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicetalk
DB_MAX_CONNS=15
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE=5m
DB_CONNECT_TIMEOUT=10s

# --- Redis (local Docker via `docker-compose up` at repo root) ---
# Host port is 6380, not the Redis default 6379 — see docker-compose.yml
# for why (an unrelated project's Redis container was already on 6379 on
# the machine this was set up on; adjust freely if that's not true for you).
REDIS_URL=redis://localhost:6380

# --- Auth (placeholder secret for local dev only — never use in production) ---
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_HOURS=72

# --- Gemini Live ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# --- CORS: comma-separated frontend origins allowed to call this API ---
ALLOWED_ORIGINS=http://localhost:6670,http://localhost:6680,http://localhost:6681,http://localhost:6690

# --- Cloudflare R2 (S3-compatible object storage) ---
# Leave blank for local dev — internal/platform/storage is not required
# for the server to boot. Populate with real values when a module that
# needs uploads (photomoment/presenter) is implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voicetalk-assets
R2_PUBLIC_BASE_URL=

# --- Platform admin panel ---
# Leave blank for local dev — platformadmin seeds no admin, so /platform/*
# has no way to log in until you set these (or create one another way).
# Only used once: if platform_admins already has a row, these are ignored.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Impersonation redirect target — blank until a merchant admin frontend exists.
MERCHANT_ADMIN_URL=
