# Production environment template.
#
# Values marked REQUIRED make the API refuse to boot while empty
# (see apps/server/src/env.ts). Copy the API block to your container host and
# each NEXT_PUBLIC_* block to the matching frontend project.
# Setup walkthrough: docs/DEPLOY.md + docs/DEPLOY-DOMAIN.md

# --- API · Postgres (Aiven or any managed Postgres; keep ?sslmode=require) ---
DATABASE_URL=postgresql://avnadmin:YOUR_DB_PASSWORD@[host]:[port]/defaultdb?sslmode=require

# --- API · Redis (Upstash: use the rediss:// connection string) ---
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-instance.upstash.io:6379

# --- API · object storage (Cloudflare R2, S3-compatible) ---
# REQUIRED: S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
# S3_PUBLIC_BASE_URL. One physical bucket; per-area prefixes.
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=lorescale
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://media.YOURDOMAIN.com

# --- API · public origin ---
# REQUIRED: origin phones can reach (menu links + photo QR codes).
PUBLIC_API_URL=https://api.YOURDOMAIN.com

# --- API · Gemini Live (voice + AI features) ---
# Needed for AI; without it /health reports ai_online:false.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# --- API · auth ---
# Set once and keep stable — changing it invalidates all sessions/tokens.
JWT_SECRET=generate-with-openssl-rand-hex-32
PLATFORM_ADMIN_EMAIL=superadmin@YOURDOMAIN.com
PLATFORM_ADMIN_PASSWORD=
# The first super admin is seeded on boot; TOTP is set up on first login.

# --- API · frontends, CORS and links ---
# Empty = every origin is accepted. Fill in before launch, e.g.
# app.YOURDOMAIN.com,admin.YOURDOMAIN.com,YOURDOMAIN.com
# (domain-only entries allow any https subdomain; Vercel previews always work).
ALLOWED_ORIGINS=
# Domains always allowed over HTTPS once ALLOWED_ORIGINS is set.
PRODUCTION_DOMAIN=YOURDOMAIN.com
# Merchant admin app — platform impersonation redirect + presentation share
# links. Must be absolute, e.g. https://app.YOURDOMAIN.com
MERCHANT_ADMIN_URL=
# Marketing site origin that hosts the /p/[token] photo QR pages.
PHOTO_DOWNLOAD_BASE_URL=https://YOURDOMAIN.com

# --- API · optional tuning (defaults shown) ---
# PORT=8000                # most hosts inject this; API_PORT is the fallback
# JWT_EXPIRE_HOURS=72
# LOG_LEVEL=info           # debug | info | warn | error
# GIT_SHA=                 # baked into CI images; only set for custom builds
# DEFAULT_BUSINESS_SLUG=sunrise-coffee
# HERO_DEMO_SLUG=lorescale

# --- Frontend · customer-app (root: apps/customer-app) ---
NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com
NEXT_PUBLIC_WS_URL=wss://api.YOURDOMAIN.com/ws/session

# --- Frontend · admin-app (root: apps/admin-app) ---
# NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com
# NEXT_PUBLIC_CUSTOMER_APP_URL=https://app.YOURDOMAIN.com

# --- Frontend · super-admin-app (root: apps/super-admin-app) ---
# NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com

# --- Frontend · marketing-app (optional, root: apps/marketing-app) ---
# Use real URLs only — template placeholders break the landing hero iframe.
# Leave unset to use production defaults (app.lorescale.com, display.lorescale.com).
# NEXT_PUBLIC_CUSTOMER_APP_URL=https://app.YOURDOMAIN.com
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.YOURDOMAIN.com
