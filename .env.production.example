# Production env — copy into your API host + frontend dashboards
# Replace YOURDOMAIN.com with your real domain (e.g. voicetalk.com)
# See docs/DEPLOY-DOMAIN.md

# --- API container (any host) ---
DATABASE_URL=postgresql://avnadmin:YOUR_DB_PASSWORD@[host]:[port]/defaultdb?sslmode=require
# Postgres connections per API instance (default 4). Keep
# instances × DB_POOL_MAX under the service connection limit; Aiven's free
# tier allows 20 total for every client combined, so 4 covers two instances
# plus the overlap of a rolling deploy (4 pods × 4 = 16).
# DB_POOL_MAX=4
# Bootstrap super-admin; use a unique, generated password stored as a secret.
# The account is created only if this email is absent. Existing accounts require
# the one-off `bun run platform-admin:reset-password` command to change passwords.
PLATFORM_ADMIN_EMAIL=superadmin@YOURDOMAIN.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-random-password
# Upstash: use the rediss:// connection string from the dashboard
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-instance.upstash.io:6379
# Object storage — Cloudflare R2 (S3-compatible). Required in production.
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=lorescale
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://media.YOURDOMAIN.com
# Required in production: public API origin used in QR links
PUBLIC_API_URL=https://api.YOURDOMAIN.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Optional: debug | info | warn | error (default info in production)
# LOG_LEVEL=info
# Deploy marker: CI bakes the build commit into the published image, and every
# log line carries it as "version". Only set this when building the image
# yourself (it overrides the baked value).
# GIT_SHA=
JWT_SECRET=generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=https://app.YOURDOMAIN.com,https://admin.YOURDOMAIN.com,https://YOURDOMAIN.com
# Optional retention / presenter knobs (defaults shown)
# ANALYTICS_RETENTION_DAYS=180
# VISION_RETENTION_DAYS=365
# PRESENTER_MAX_VIEWERS_PER_SESSION=20

# --- Vercel customer-app (root: apps/customer-app) ---
NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com
NEXT_PUBLIC_WS_URL=wss://api.YOURDOMAIN.com/ws/session

# --- Vercel admin-app (root: apps/admin-app) ---
# NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com
# NEXT_PUBLIC_CUSTOMER_APP_URL=https://app.YOURDOMAIN.com

# --- Vercel marketing-app (optional, root: apps/marketing-app) ---
# Use your real customer + admin URLs. Leave unset to use production defaults
# (voice-talk-customer.vercel.app + app.lorescale.com). Do NOT paste template
# placeholders like https://app.YOURDOMAIN.com — they break the landing hero.
# NEXT_PUBLIC_CUSTOMER_APP_URL=https://app.YOURDOMAIN.com
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.YOURDOMAIN.com
