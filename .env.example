# Copy this file to apps/server/.env — Bun loads the .env next to that
# workspace's package.json, with .env.local taking precedence.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview
API_PORT=8000
# Postgres (production: Aiven or any managed Postgres). Local dev:
# DATABASE_URL=postgresql://localhost:5432/voicetalk
# Managed poolers work as-is (the server connects with prepare:false).
DATABASE_URL=postgresql://avnadmin:[password]@[host]:[port]/defaultdb?sslmode=require
# Redis: login/kiosk rate limits + background-job locks, shared by all API
# instances. Upstash uses rediss://; local dev: docker compose up -d redis
# (maps 6380 -> 6379).
REDIS_URL=redis://127.0.0.1:6380
# Object storage (S3-compatible). Dev/tests fall back to local disk when
# unset; production requires it (container disks are ephemeral).
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com,
# public base is the bucket's r2.dev URL or a custom domain.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=lorescale
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com
JWT_SECRET=dev-secret-change-in-production
# Production: comma-separated CORS entries (full URLs, hostnames, or domains)
# ALLOWED_ORIGINS=https://app.yourdomain.com,admin.yourdomain.com,yourdomain.com
# PRODUCTION_DOMAIN=lorescale.com
DEFAULT_BUSINESS_SLUG=sunrise-coffee
NEXT_PUBLIC_HERO_DEMO_SLUG=lorescale
ADMIN_EMAIL=admin@sunrise.coffee
ADMIN_PASSWORD=admin123
LORESCALE_ADMIN_EMAIL=admin@lorescale.com
LORESCALE_ADMIN_PASSWORD=lorescale123
# Demo account for testing registration approval (status: pending)
PENDING_DEMO_EMAIL=demo.pending@lorescale.com
PENDING_DEMO_PASSWORD=pendingdemo123
PLATFORM_ADMIN_EMAIL=superadmin@lorescale.com
PLATFORM_ADMIN_PASSWORD=superadmin123
MERCHANT_ADMIN_URL=http://localhost:6680
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/session
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:6670
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:6680
NEXT_PUBLIC_SUPER_ADMIN_APP_URL=http://localhost:6681
NEXT_PUBLIC_MARKETING_APP_URL=http://localhost:6690
# Public photo QR — phones cannot open localhost. Set this to the API origin
# phones can reach (the demo tunnel script sets it automatically).
# PUBLIC_API_URL=https://api.yourdomain.com
# Optional fallback only — Lorescale uses 3D by default
# NEXT_PUBLIC_USE_PNG_AVATAR=true
# Production CORS should include Super Admin origin, e.g.:
# ALLOWED_ORIGINS=https://app.lorescale.com,https://dashboard.lorescale.com,https://admin.lorescale.com,lorescale.com
