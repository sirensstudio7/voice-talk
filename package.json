{
  "name": "voicetalk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run api:ensure && bun run --filter customer-app dev",
    "dev:admin": "bun run api:ensure && bun run --filter admin-app dev",
    "dev:super-admin": "bun run api:ensure && bun run --filter super-admin-app dev",
    "dev:marketing": "bun run --filter marketing-app dev",
    "dev:api": "bash scripts/dev-api.sh start",
    "api:restart": "bash scripts/dev-api.sh restart",
    "api:stop": "bash scripts/dev-api.sh stop",
    "api:health": "bash scripts/dev-api.sh health",
    "api:ensure": "bash scripts/dev-api.sh ensure",
    "vision:ensure": "bash scripts/dev-vision.sh ensure",
    "vision:restart": "VISION_DEBUG=1 bash scripts/dev-vision.sh restart",
    "dev:all": "concurrently \"bun run dev:api\" \"bun run dev\" \"bun run dev:admin\" \"bun run dev:super-admin\" \"bun run dev:marketing\"",
    "seed:db": "bun run --filter server db:migrate && bun run --filter server seed",
    "seed:demo-analytics": "bun run --filter server seed:demo-analytics",
    "seed:demo-analytics:force": "bun run --filter server seed:demo-analytics:force",
    "setup:db": "bash scripts/setup-db.sh",
    "check:deploy": "bash scripts/check-deploy-env.sh",
    "lint:api": "bun run --filter server lint",
    "test:api": "bun run --filter server test",
    "demo:cloudflare": "bash scripts/demo-cloudflare.sh",
    "vision:dev": "cd services/vision && python main.py --business ${BUSINESS_SLUG:-demo} --ws-url ws://localhost:8000/ws/vision --debug"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
